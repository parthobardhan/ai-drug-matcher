{
  "name": "optum-drug-matcher-backend",
  "version": "1.0.0",
  "description": "Backend API for Optum RX Drug Matcher Demo",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedDatabase.js",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "jest --watch",
    "test:vector": "node scripts/testVectorSearch.js",
    "check:embeddings": "node scripts/checkEmbeddings.js"
  },
  "keywords": ["optum", "drug", "mongodb", "vector-search"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0"
  }
}

